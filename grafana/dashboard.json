{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Peers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "msst_core_peers_total", "legendFormat": "Total" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "title": "Room Peers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "msst_core_room_peers_total", "legendFormat": "Room" }]
    },
    {
      "title": "ACL Rules",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "msst_core_acl_rules_total", "legendFormat": "Rules" }]
    },
    {
      "title": "WG Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "msst_core_wg_sessions_total", "legendFormat": "Sessions" }]
    },
    {
      "title": "Coordinator",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "msst_core_coordinator_connected", "legendFormat": "Connected" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Disconnected", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "Connected", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "msst_core_uptime_seconds", "legendFormat": "Seconds" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Packets Received (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "rate(msst_core_packets_received_total[1m])", "legendFormat": "{{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "pps" } }
    },
    {
      "title": "Packets Sent (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "rate(msst_core_packets_sent_total[1m])", "legendFormat": "{{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "pps" } }
    },
    {
      "title": "ACL Decisions (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(msst_core_acl_decisions_total[1m])", "legendFormat": "{{decision}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Path Mode Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "msst_core_path_modes", "legendFormat": "{{mode}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "title": "WG Handshakes (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "rate(msst_core_wg_handshakes_total[5m])", "legendFormat": "{{result}}" }
      ]
    },
    {
      "title": "Scheduler Tick Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "msst_core_scheduler_tick_duration_ms", "legendFormat": "ms" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Generation Counter",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 28 },
      "targets": [
        { "expr": "msst_core_generation", "legendFormat": "generation" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["msst-net", "core"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MSST-Net Core",
  "uid": "msst-net-core",
  "version": 1
}